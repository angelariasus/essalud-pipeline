# ============================================================================
# Plantilla de variables de entorno — EsSalud Pipeline (copiar a .env y editar).
# El .env real NO se versiona (.gitignore). Los valores de ejemplo funcionan
# con el stack local por defecto (SQL Server local o contenedor del compose).
# ============================================================================

# ── API OCDS (Bronze) ───────────────────────────────────────────────────────
# OCDS_API_BASE_URL=https://contratacionesabiertas.oece.gob.pe/api/v1
# OCDS_ESSALUD_RUC=20131257750

# ── Cloudflare R2 (OPCIONAL — solo réplica del Bronze; false = 100% local) ──
OCDS_USE_R2=false
# OCDS_R2_ACCOUNT_ID=
# OCDS_R2_ACCESS_KEY=
# OCDS_R2_SECRET_KEY=
# OCDS_R2_BUCKET_NAME=essalud-bronze-lake

# ── Java / Hadoop (Windows; PySpark los necesita para Silver/Gold) ──────────
JAVA_HOME=C:\Program Files\Java\jdk-21
HADOOP_HOME=C:\hadoop

# ── Spark ───────────────────────────────────────────────────────────────────
# local[4] en Windows (más workers UDF crashea); local[*] en Linux/Docker.
# OCDS_SPARK_MASTER=local[4]
OCDS_SPARK_JARS_PACKAGES=com.microsoft.sqlserver:mssql-jdbc:12.4.2.jre11

# ── Data Warehouse: SQL Server LOCAL (gold --target sqlserver) ──────────────
# Cadena pyodbc/SQLAlchemy para DDL + stored procedure. Con Windows Auth
# (trusted_connection=yes) define ADEMÁS las OCDS_DW_JDBC_* de abajo: la
# escritura de Spark exige SQL Auth (no hereda la autenticación de Windows).
OCDS_DW_CONN_STRING=mssql+pyodbc://localhost/DW_EsSalud_Adquisiciones?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
OCDS_DW_JDBC_URL=jdbc:sqlserver://localhost;databaseName=DW_EsSalud_Adquisiciones;encrypt=true;trustServerCertificate=true
OCDS_DW_JDBC_USER=essalud_user
OCDS_DW_JDBC_PASSWORD=<password-del-login-sql>
# OCDS_DW_JDBC_BATCHSIZE=10000

# ── DW perfil DOCKER (gold --target sqlserver --profile docker, desde host) ─
# Apunta al servicio `sqlserver` del docker-compose (puerto publicado 11433).
OCDS_DW_CONN_STRING_DOCKER=mssql+pyodbc://sa:EsSalud2024!@localhost:11433/DW_EsSalud_Adquisiciones?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes
OCDS_DW_JDBC_URL_DOCKER=jdbc:sqlserver://localhost:11433;databaseName=DW_EsSalud_Adquisiciones;encrypt=true;trustServerCertificate=true
OCDS_DW_JDBC_USER_DOCKER=sa
OCDS_DW_JDBC_PASSWORD_DOCKER=EsSalud2024!
# MSSQL_SA_PASSWORD=EsSalud2024!   # password sa del contenedor (compose)

# ── IA Gemini (Silver, opcional: vacío = limpieza no-op con degradación) ────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Fase 6: alertas por correo (SMTP) ───────────────────────────────────────
# MailHog local (sin credenciales, UI http://localhost:8025):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
# Gmail App Password (producción de prueba):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=cuenta@gmail.com
# SMTP_PASSWORD=<app-password>
SMTP_FROM=alertas@essalud-pipeline.local
SMTP_TO=fernando.barrera@unmsm.edu.pe

# ── Otros ───────────────────────────────────────────────────────────────────
# OCDS_LOG_LEVEL=INFO
# OCDS_MAX_RETRIES=5
# OCDS_BACKOFF_FACTOR=0.5
# OCDS_ENV_FILE=            # dotenv alternativo (lo usa el contenedor: .env.docker)

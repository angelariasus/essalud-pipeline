# ============================================================================
# Dotenv del CONTENEDOR (Airflow worker). Lo selecciona OCDS_ENV_FILE en
# docker-compose.yaml; sustituye al .env de Windows (que se monta junto al repo
# en /opt/airflow/bi y rompería Spark con JAVA_HOME/HADOOP_HOME de Windows).
# Sin rutas Windows: JAVA_HOME lo define la imagen (/usr/lib/jvm/default-java).
# ============================================================================

# Spark en Linux: sin el bug de workers de Windows -> todos los cores.
OCDS_SPARK_MASTER=local[*]
OCDS_SPARK_JARS_PACKAGES=com.microsoft.sqlserver:mssql-jdbc:12.4.2.jre11

# DW en el servicio `sqlserver` del compose (la BD la crea sqlserver-init).
OCDS_DW_CONN_STRING=mssql+pyodbc://sa:EsSalud2024!@sqlserver:1433/DW_EsSalud_Adquisiciones?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
OCDS_DW_JDBC_URL=jdbc:sqlserver://sqlserver:1433;databaseName=DW_EsSalud_Adquisiciones;encrypt=true;trustServerCertificate=true
OCDS_DW_JDBC_USER=sa
OCDS_DW_JDBC_PASSWORD=EsSalud2024!

# Fase 6 — correo de alertas capturado por MailHog (UI: http://localhost:8025).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=alertas@essalud-pipeline.local
SMTP_TO=fernando.barrera@unmsm.edu.pe

# IA Gemini (opcional: vacío = limpieza no-op).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudflare R2 (opcional, SOLO réplica de Bronze; false = 100% local).
OCDS_USE_R2=false
